DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/fretehub?schema=public"
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_FORTE_E_ALEATORIA"
ENCRYPTION_KEY="SUBSTITUA_POR_OUTRA_CHAVE_FORTE_E_ALEATORIA"
PORT=3001
NODE_ENV=development

# Jamef — preencher apenas ao ativar a integração real
JAMEF_API_ENABLED=false
JAMEF_AUTH_URL=""
JAMEF_QUOTE_URL=""
# Produção: https://api.jamef.com.br/consulta/v1
# Homologação: https://api-qa.jamef.com.br/consulta/v1
JAMEF_TRACKING_URL=""
JAMEF_USERNAME=""
JAMEF_PASSWORD=""
JAMEF_TOKEN=""
JAMEF_DOCUMENTO_DEVEDOR=""
JAMEF_DOCUMENTO_REMETENTE=""
JAMEF_CEP_ORIGEM=""

# Braspress — preencher apenas ao ativar a integração real
BRASPRESS_API_ENABLED=false
BRASPRESS_QUOTE_URL=""
BRASPRESS_USERNAME=""
BRASPRESS_PASSWORD=""
BRASPRESS_CNPJ_REMETENTE=""

# Monitoramento automático de cargas (intervalo fixo de 1 hora)
TRACKING_WORKER_ENABLED=true
TRACKING_BATCH_SIZE=20
BRASPRESS_TRACKING_URL=""

# Camilo / SSW — cotação SOAP e tracking pelo portal SSW
# Endpoint de produção: https://ssw.inf.br/ws/sswCotacaoCliente/index.php
# As credenciais podem ser cadastradas pelo painel; use o .env apenas como alternativa.
CAMILO_API_ENABLED=false
CAMILO_QUOTE_URL="https://ssw.inf.br/ws/sswCotacaoCliente/index.php"
CAMILO_TRACKING_URL="https://ssw.inf.br/2/ssw_resultSSW"
CAMILO_DOMAIN=""
CAMILO_USERNAME=""
CAMILO_PASSWORD=""
CAMILO_PAYER_PASSWORD=""
CAMILO_MERCHANDISE_CODE=1

# Correios — ainda utiliza serviço de demonstração neste projeto
CORREIOS_API_ENABLED=false
CORREIOS_USERNAME=""
CORREIOS_PASSWORD=""
CORREIOS_TOKEN=""

# Somente para demonstração local. Em produção, mantenha false.
ALLOW_MOCK_QUOTES=false

# Prévia de cotação (opcional; se vazio, usa JWT_SECRET ou ENCRYPTION_KEY)
QUOTE_DRAFT_SECRET=""

# Central de notificações e e-mail transacional
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATION_BATCH_SIZE=40
EMAIL_PROVIDER="none"
EMAIL_FROM="FreteHub <notificacoes@seudominio.com.br>"
APP_URL="http://localhost:5173"

# Gmail/SMTP: porta 587 + STARTTLS (SMTP_SECURE=false)
# ou porta 465 + SSL direto (SMTP_SECURE=true)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_REPLY_TO=""

# Alternativa 1: webhook próprio/automação
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""

# Alternativa 2: Resend
RESEND_API_KEY=""

# Diretório opcional para comprovantes de entrega
DELIVERY_PROOF_DIR=

# Diretório opcional para logomarcas enviadas no cadastro de empresas
COMPANY_LOGO_DIR=

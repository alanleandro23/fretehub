generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum IntegrationType {
  API
  PORTAL
  MANUAL
}

enum Environment {
  HOMOLOGACAO
  PRODUCAO
}

enum FreightType {
  CIF
  FOB
  TERCEIROS
}

enum QuoteStatus {
  DRAFT
  COMPLETED
  ERROR
  INACTIVE
}

enum ResultStatus {
  success
  error
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  passwordHash       String
  name               String
  role               Role     @default(OPERATOR)
  companyId          Int?
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  quotes    Quote[]
  trackings ShipmentTracking[]
  notificationRecipients NotificationRecipient[]
  deliveryProofs         DeliveryProof[]
  proposalLogs           QuoteProposalLog[]

  @@index([companyId])
}

model Company {
  id                Int      @id @default(autoincrement())
  razaoSocial       String
  nomeFantasia      String?
  cnpj              String   @unique
  inscricaoEstadual String?
  cep               String
  endereco          String
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String
  uf                String
  telefone          String?
  email             String?
  logoUrl           String?
  logoFileName      String?
  logoMimeType      String?
  logoStoragePath   String?
  logoUpdatedAt     DateTime?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  credentials CarrierCredential[]
  quotes      Quote[]
  users       User[]
  trackings   ShipmentTracking[]
}

model Product {
  id           Int      @id @default(autoincrement())
  description  String   @unique
  lengthMeters Decimal  @db.Decimal(10, 3)
  widthMeters  Decimal  @db.Decimal(10, 3)
  heightMeters Decimal  @db.Decimal(10, 3)
  weightKg     Decimal  @db.Decimal(10, 3)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quoteItems QuoteItem[]

  @@index([description])
}

model Carrier {
  id             Int             @id @default(autoincrement())
  nome           String          @unique
  logoUrl        String?
  tipoIntegracao IntegrationType @default(API)
  ambientePadrao Environment     @default(HOMOLOGACAO)
  apiUrl         String?
  portalUrl      String?
  observacoes    String?
  ativo          Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  credentials CarrierCredential[]
  results     QuoteResult[]
  trackings   ShipmentTracking[]
}

model CarrierCredential {
  id                 Int         @id @default(autoincrement())
  companyId          Int
  carrierId          Int
  usuario            String?
  senhaCriptografada String?
  tokenCriptografado String?
  codigoCliente      String?
  contrato           String?
  cnpjVinculado      String?
  ambiente           Environment @default(HOMOLOGACAO)
  ativo              Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  carrier Carrier @relation(fields: [carrierId], references: [id])

  @@unique([companyId, carrierId, ambiente])
}

model Quote {
  id                      Int         @id @default(autoincrement())
  draftId                 String?     @unique
  companyId               Int
  userId                  Int?
  cnpjDestinatario        String
  razaoSocialDestinatario String?
  cepDestino              String
  enderecoDestino         String?
  cidadeDestino           String?
  ufDestino               String?
  cnpjTerceiro            String?
  razaoSocialTerceiro     String?
  valorMercadoria         Decimal     @db.Decimal(12, 2)
  pesoTotal               Decimal     @db.Decimal(12, 3)
  quantidadeVolumes       Int
  tipoFrete               FreightType
  modal                   String
  status                  QuoteStatus @default(COMPLETED)
  createdAt               DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  items   QuoteItem[]
  results   QuoteResult[]
  trackings ShipmentTracking[]
  proposalLogs QuoteProposalLog[]
}

model QuoteItem {
  id          Int     @id @default(autoincrement())
  quoteId     Int
  productId   Int?
  sku         String?
  descricao   String?
  comprimento Decimal @db.Decimal(10, 3)
  largura     Decimal @db.Decimal(10, 3)
  altura      Decimal @db.Decimal(10, 3)
  peso        Decimal @db.Decimal(10, 3)
  quantidade  Int
  cubagem     Decimal @db.Decimal(10, 4)

  quote   Quote    @relation(fields: [quoteId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([productId])
}

model QuoteResult {
  id          Int          @id @default(autoincrement())
  quoteId     Int
  carrierId   Int
  status      ResultStatus
  valorFrete  Decimal?     @db.Decimal(12, 2)
  prazo       String?
  modalidade  String?
  mensagem    String?
  rawResponse Json?
  createdAt   DateTime     @default(now())

  quote   Quote   @relation(fields: [quoteId], references: [id])
  carrier Carrier @relation(fields: [carrierId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  payload   Json?
  createdAt DateTime @default(now())
}

model ShipmentTracking {
  id              Int       @id @default(autoincrement())
  quoteId         Int?
  carrierId       Int?
  companyId       Int?
  userId          Int?

  numeroNota      String?
  numeroPedido    String?
  conhecimento    String?
  documento       String?

  status          String?
  previsaoEntrega DateTime?
  dataEntrega     DateTime?
  cidadeDestino    String?
  ufDestino        String?
  destinatarioNome String?
  hasDivergence    Boolean  @default(false)

  monitoringActive     Boolean  @default(true)
  checkIntervalMinutes Int      @default(30)
  lastCheckedAt        DateTime?
  nextCheckAt          DateTime @default(now())
  lastCheckError       String?
  consecutiveErrors    Int      @default(0)
  notificationSentAt          DateTime?
  emailNotificationSentAt     DateTime?
  emailNotificationError      String?
  emailNotificationAttempts   Int       @default(0)
  emailNotificationNextAttemptAt DateTime?

  rawResponse Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  carrier Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  events  ShipmentEvent[]
  notifications Notification[]
  deliveryProofs DeliveryProof[]

  @@index([monitoringActive, nextCheckAt])
  @@index([companyId, carrierId])
  @@index([status])
  @@index([emailNotificationSentAt, emailNotificationNextAttemptAt])
}

model ShipmentEvent {
  id          Int       @id @default(autoincrement())
  trackingId  Int
  descricao   String
  dataEvento  DateTime?
  cidade      String?
  uf          String?
  tipo        String?
  rawResponse Json?
  createdAt   DateTime  @default(now())

  tracking ShipmentTracking @relation(fields: [trackingId], references: [id])
}




model DeliveryProof {
  id           Int      @id @default(autoincrement())
  trackingId   Int
  uploadedById Int?
  source       String   @default("MANUAL")
  fileName     String?
  mimeType     String?
  storagePath  String?
  externalUrl  String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tracking   ShipmentTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  uploadedBy User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([trackingId, createdAt])
  @@index([uploadedById])
}

model Notification {
  id          Int      @id @default(autoincrement())
  type        String
  severity    String   @default("info")
  title       String
  message     String
  fingerprint String   @unique
  trackingId  Int?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tracking   ShipmentTracking?      @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([trackingId, type])
  @@index([createdAt])
}

model NotificationRecipient {
  id                         Int       @id @default(autoincrement())
  notificationId             Int
  userId                     Int
  readAt                     DateTime?
  archivedAt                 DateTime?
  emailSentAt                DateTime?
  emailError                 String?
  emailAttempts              Int       @default(0)
  emailNextAttemptAt         DateTime? @default(now())
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt, archivedAt])
  @@index([emailSentAt, emailNextAttemptAt])
}

model SystemSetting {
  key         String   @id
  value       String?
  encrypted   Boolean  @default(false)
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model QuoteProposalLog {
  id         Int      @id @default(autoincrement())
  quoteId    Int
  userId     Int?
  recipients Json
  cc         Json?
  subject    String
  message    String?
  formats    Json
  provider   String?
  status     String   @default("PENDING")
  error      String?
  sentAt     DateTime?
  createdAt  DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
  @@index([userId])
}
